---
import BenefitsLetter from "../components/BenefitsLetter.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card";
import HeaderSection from "../components/HeaderSection.jsx";
import Main from "../components/Main.astro";
import Layout from "../layout/Layout.astro";
import data from "./../data/Documento.json";
---

<Layout>
    <Main />

    <section class="bg-white py-16 px-4">
        <div class="max-w-6xl mx-auto">
            <HeaderSection
                title="¿Qué necesitas conocer sobre"
                subTitle="la Universidad?"
                description="Información esencial para tu trayectoria académica en la UNET."
            >
                <svg
                    class="w-8 h-8 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 14l9-5-9-5-9 5 9 5z"></path>
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 14l9-5-9-5-9 5 9 5z"></path>
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 14v6l9-5m-9 5l-9-5m9 5l9-5"></path>
                </svg>
            </HeaderSection>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
                <Card
                    title={data[0].titulo}
                    content={data[0].descripcion}
                    hora=""
                    dias=""
                    correo=""
                    jefe_departamento=""
                    client:load
                />
                <Card
                    title={data[1].titulo}
                    content={data[1].descripcion}
                    hora=""
                    dias=""
                    correo=""
                    jefe_departamento=""
                    client:load
                />
                <Card
                    title={data[10].titulo}
                    content={data[10].descripcion}
                    hora=""
                    dias=""
                    correo=""
                    jefe_departamento=""
                    client:load
                />
            </div>

            <div class="text-center mb-16">
                <Button href="/NormasDeEstudio" text="Ver más documentos" />
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <BenefitsLetter
                    title="Beca Estudiantil"
                    subTitle="Beneficio económico para estudiantes con buen rendimiento académico, destinado a apoyar su formación y desarrollo en la UNET."
                    color="blue"
                    ColorSVGUP="blue"
                    ColorSVGDW="cyan"
                >
                    <svg
                        slot="icon"
                        class="w-8 h-8 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 14l9-5-9-5-9 5 9 5z"></path>
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 14l9-5-9-5-9 5 9 5z"></path>
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 14v6l9-5m-9 5l-9-5m9 5l9-5"></path>
                    </svg>
                </BenefitsLetter>

                <BenefitsLetter
                    title="Beca Francia"
                    subTitle="Programa de becas para intercambios académicos en universidades francesas. Incluye control de estudios y gestión del carnet estudiantil internacional."
                    color="red"
                    hasButton={true}
                    ColorSVGUP="red"
                    ColorSVGDW="pink"
                    href="/BecaFrancia"
                    textButton="Solicitar beca"
                >
                    <svg
                        slot="icon"
                        class="w-8 h-8 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 14l9-5-9-5-9 5 9 5z"></path>
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 14l9-5-9-5-9 5 9 5z"></path>
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 14v6l9-5m-9 5l-9-5m9 5l9-5"></path>
                    </svg>
                </BenefitsLetter>

                <BenefitsLetter
                    title="Carnet Universitario"
                    subTitle="Tu identificación oficial como estudiante UNET. Esencial para acceso a instalaciones, biblioteca, eventos universitarios y descuentos estudiantiles en diversos establecimientos."
                    color="purple"
                    hasButton={false}
                    ColorSVGUP="purple"
                    ColorSVGDW="pink"
                >
                    <svg
                        slot="icon"
                        class="w-8 h-8 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5zm6-10.125a1.875 1.875 0 11-3.75 0 1.875 1.875 0 013.75 0zm1.294 6.336a6.721 6.721 0 01-3.17.789 6.721 6.721 0 01-3.168-.789 3.376 3.376 0 016.338 0z"
                        ></path>
                    </svg>
                </BenefitsLetter>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <BenefitsLetter
                    title="Pensum"
                    subTitle="Descubre el plan completo de materias y tu trayectoria académica"
                    color="green"
                    ColorSVGUP="green"
                    ColorSVGDW="emerald"
                    hasButton={true}
                    href="/Pensum"
                    textButton="Conocer más sobre las materias"
                >
                    <svg
                        slot="icon"
                        class="w-8 h-8 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                        ></path>
                    </svg>
                </BenefitsLetter>

                <BenefitsLetter
                    title="Departamentos Académicos"
                    subTitle="Descubre los departamentos académicos de las Carreras"
                    color="blue"
                    ColorSVGUP="blue"
                    ColorSVGDW="cyan"
                    hasButton={true}
                    href="/Departamentos"
                    textButton="Conocer más sobre los departamentos"
                >
                    <svg
                        slot="icon"
                        class="w-8 h-8 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                        ></path>
                    </svg>
                </BenefitsLetter>

                <BenefitsLetter
                    title="Beca y Correo Estudiantil"
                    subTitle="Descubre sobre los beneficios de la beca y el correo estudiantil"
                    color="purple"
                    ColorSVGUP="purple"
                    ColorSVGDW="pink"
                    hasButton={true}
                    href="/BecaAndCorreo"
                    textButton="Conocer más sobre beneficios"
                >
                    <svg
                        slot="icon"
                        class="w-8 h-8 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                    </svg>
                </BenefitsLetter>
            </div>
        </div>
    </section>

    <style>
        @keyframes pulse-slow {
            0%,
            100% {
                opacity: 0.3;
            }
            50% {
                opacity: 0.5;
            }
        }
        .animate-pulse-slow {
            animation: pulse-slow 6s ease-in-out infinite;
        }
        .animation-delay-2000 {
            animation-delay: 2s;
        }
        .animation-delay-4000 {
            animation-delay: 4s;
        }
    </style>
</Layout>
