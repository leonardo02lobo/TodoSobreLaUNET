---
import Card from "../components/Card.astro";
import Main from "../components/Main.astro";
import Layout from "../layout/Layout.astro";
import data from "./../data/Documento.json";
---

<Layout>
    <Main />

    <section class="bg-white py-16 px-4">
        <div class="max-w-6xl mx-auto">
            <div class="text-center mb-16">
                <div class="inline-block">
                    <div class="mb-4">
                        <div class="w-16 h-16 bg-linear-to-br from-indigo-500 to-purple-500 rounded-2xl flex items-center justify-center shadow-lg mx-auto mb-4">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14v6l9-5m-9 5l-9-5m9 5l9-5"></path>
                            </svg>
                        </div>
                    </div>
                    <h1 class="text-4xl font-bold text-gray-800 mb-4">
                        Qué necesitas conocer sobre <br>
                        <span class="bg-linear-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">
                            la Universidad
                        </span>
                    </h1>
                    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                        Información esencial para tu trayectoria académica en la UNET
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
                <Card
                    title={data[0].titulo}
                    content={data[0].descripcion}
                    hora=""
                    dias=""
                    correo=""
                    jefe_departamento=""
                />
                <Card
                    title={data[1].titulo}
                    content={data[1].descripcion}
                    hora=""
                    dias=""
                    correo=""
                    jefe_departamento=""
                />
                <Card
                    title={data[10].titulo}
                    content={data[10].descripcion}
                    hora=""
                    dias=""
                    correo=""
                    jefe_departamento=""
                />
            </div>

            <div class="text-center mb-16">
                <a
                    href="/NormasDeEstudio"
                    class="bg-linear-to-r from-indigo-500 to-purple-500 text-white px-8 py-4 rounded-xl font-semibold transition-all duration-300 hover:shadow-lg hover:transform hover:scale-105 inline-block"
                >
                    Mirar todas las normas de estudio
                </a>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div class="bg-white rounded-2xl p-8 shadow-lg border border-gray-100 hover:shadow-xl transition-all duration-300 group hover:border-blue-200 text-center">
                    <div class="w-16 h-16 bg-linear-to-br from-green-500 to-emerald-500 rounded-2xl flex items-center justify-center shadow-md mx-auto mb-6">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                        </svg>
                    </div>
                    <h2 class="text-2xl font-bold text-gray-800 mb-4">
                        Pensum
                    </h2>
                    <p class="text-gray-600 mb-6 leading-relaxed">
                        Descubre el plan completo de materias y tu trayectoria académica
                    </p>
                    <a
                        href="/Pensum"
                        class="inline-block bg-linear-to-r from-green-500 to-emerald-500 text-white px-6 py-3 rounded-lg font-semibold transition-all duration-300 hover:shadow-md hover:transform hover:scale-105"
                    >
                        Conocer más sobre las materias
                    </a>
                </div>

                <div class="bg-white rounded-2xl p-8 shadow-lg border border-gray-100 hover:shadow-xl transition-all duration-300 group hover:border-blue-200 text-center">
                    <div class="w-16 h-16 bg-linear-to-br from-blue-500 to-cyan-500 rounded-2xl flex items-center justify-center shadow-md mx-auto mb-6">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                        </svg>
                    </div>
                    <h2 class="text-2xl font-bold text-gray-800 mb-4">
                        Departamentos Académicos
                    </h2>
                    <p class="text-gray-600 mb-6 leading-relaxed">
                        Descubre los departamentos académicos de las Carreras
                    </p>
                    <a
                        href="/Departamentos"
                        class="inline-block bg-linear-to-r from-blue-500 to-cyan-500 text-white px-6 py-3 rounded-lg font-semibold transition-all duration-300 hover:shadow-md hover:transform hover:scale-105"
                    >
                        Conocer más sobre los departamentos
                    </a>
                </div>

                <div class="bg-white rounded-2xl p-8 shadow-lg border border-gray-100 hover:shadow-xl transition-all duration-300 group hover:border-blue-200 text-center">
                    <div class="w-16 h-16 bg-linear-to-br from-purple-500 to-pink-500 rounded-2xl flex items-center justify-center shadow-md mx-auto mb-6">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h2 class="text-2xl font-bold text-gray-800 mb-4">
                        Beca y Correo Estudiantil
                    </h2>
                    <p class="text-gray-600 mb-6 leading-relaxed">
                        Descubre sobre los beneficios de la beca y el correo estudiantil
                    </p>
                    <a
                        href="/BecaAndCorreo"
                        class="inline-block bg-linear-to-r from-purple-500 to-pink-500 text-white px-6 py-3 rounded-lg font-semibold transition-all duration-300 hover:shadow-md hover:transform hover:scale-105"
                    >
                        Conocer más sobre beneficios
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    @keyframes pulse-slow {
        0%, 100% { opacity: 0.3; }
        50% { opacity: 0.5; }
    }
    .animate-pulse-slow {
        animation: pulse-slow 6s ease-in-out infinite;
    }
    .animation-delay-2000 {
        animation-delay: 2s;
    }
    .animation-delay-4000 {
        animation-delay: 4s;
    }
</style>