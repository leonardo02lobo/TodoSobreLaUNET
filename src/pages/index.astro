---
import Card from "../components/Card.astro";
import Main from "../components/Main.astro";
import Layout from "../layout/Layout.astro";
---

<Layout>
    <Main />
    <section class="flex flex-col justify-center items-center gap-12">
        <span class="text-4xl font-bold flex flex-col text-center">
            <font>Que necesitas conocer</font>
            <font>sobre la Universidad</font>
        </span>
        <div class="grid grid-cols-3 gap-10 pl-10 pr-10">
            <Card />
            <Card />
            <Card />
        </div>
        <div
            class="bg-white rounded-2xl p-10 flex flex-col justify-center items-center gap-4"
        >
            <span class="text-4xl font-bold flex flex-col text-center">
                <font>Que es el Pensum</font>
            </span>
            <a href="">Mirar nuestro pensum</a>
            <a href="">Conocer mas sobre las materias</a>
        </div>
    </section>
</Layout>
