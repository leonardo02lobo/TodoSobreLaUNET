---
import Card from "../components/Card";
import Main from "../components/Main.astro";
import Layout from "../layout/Layout.astro";
import data from "./../data/Documento.json";
---

<Layout>
    <Main />

    <section class="bg-white py-16 px-4">
        <div class="max-w-6xl mx-auto">
            <div class="text-center mb-16">
                <div class="inline-block">
                    <div class="mb-4">
                        <div
                            class="w-16 h-16 bg-linear-to-br from-indigo-500 to-purple-500 rounded-2xl flex items-center justify-center shadow-lg mx-auto mb-4"
                        >
                            <svg
                                class="w-8 h-8 text-white"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 14l9-5-9-5-9 5 9 5z"></path>
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 14l9-5-9-5-9 5 9 5z"></path>
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 14v6l9-5m-9 5l-9-5m9 5l9-5"></path>
                            </svg>
                        </div>
                    </div>
                    <h1 class="text-4xl font-bold text-gray-800 mb-4">
                        ¿Qué necesitas conocer sobre <br />
                        <span
                            class="bg-linear-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent"
                        >
                            la Universidad?
                        </span>
                    </h1>
                    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                        Información esencial para tu trayectoria académica en la
                        UNET
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
                <Card
                    title={data[0].titulo}
                    content={data[0].descripcion}
                    hora=""
                    dias=""
                    correo=""
                    jefe_departamento=""
                    client:load
                />
                <Card
                    title={data[1].titulo}
                    content={data[1].descripcion}
                    hora=""
                    dias=""
                    correo=""
                    jefe_departamento=""
                    client:load
                />
                <Card
                    title={data[10].titulo}
                    content={data[10].descripcion}
                    hora=""
                    dias=""
                    correo=""
                    jefe_departamento=""
                    client:load
                />
            </div>

            <div class="text-center mb-16">
                <a
                    href="/NormasDeEstudio"
                    class="bg-linear-to-r from-indigo-500 to-purple-500 text-white px-8 py-4 rounded-xl font-semibold transition-all duration-300 hover:shadow-lg hover:transform hover:scale-105 inline-block"
                >
                    Mirar todas las normas de estudio
                </a>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Card: Control de Estudios -->
                <div
                    class="bg-white rounded-2xl p-8 shadow-lg border border-gray-100 hover:shadow-xl transition-all duration-300 group hover:border-blue-200 text-center flex flex-col min-h-[400px]"
                >
                    <div
                        class="w-16 h-16 bg-linear-to-br from-blue-500 to-cyan-500 rounded-2xl flex items-center justify-center shadow-md mx-auto mb-6"
                    >
                        <svg
                            class="w-8 h-8 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                            ></path>
                        </svg>
                    </div>
                    <h2 class="text-2xl font-bold text-gray-800 mb-4">
                        Control de Estudios
                    </h2>
                    <p class="text-gray-600 mb-6 leading-relaxed grow">
                        Departamento encargado de gestionar tu historial
                        académico, certificaciones, trámites de inscripción y
                        todo lo relacionado con tu trayectoria estudiantil en la
                        UNET.
                    </p>
                </div>

                <!-- Card: Beca Francia -->
                <div
                    class="bg-white rounded-2xl p-8 shadow-lg border border-gray-100 hover:shadow-xl transition-all duration-300 group hover:border-red-200 text-center flex flex-col min-h-[400px]"
                >
                    <div
                        class="w-16 h-16 bg-linear-to-br from-red-500 to-pink-500 rounded-2xl flex items-center justify-center shadow-md mx-auto mb-6"
                    >
                        <svg
                            class="w-8 h-8 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 14l9-5-9-5-9 5 9 5z"
                            ></path>
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 14l9-5-9-5-9 5 9 5z"
                            ></path>
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 14v6l9-5m-9 5l-9-5m9 5l9-5"
                            ></path>
                        </svg>
                    </div>
                    <h2 class="text-2xl font-bold text-gray-800 mb-4">
                        Beca Francia
                    </h2>
                    <p class="text-gray-600 mb-6 leading-relaxed grow">
                        Programa de becas para intercambios académicos en universidades francesas.
                        Incluye control de estudios y gestión del carnet estudiantil internacional.
                    </p>
                    <div class="mt-auto">
                        <a
                            href="/BecaFrancia"
                            class="inline-block bg-linear-to-r from-red-500 to-pink-500 text-white px-6 py-3 rounded-lg font-semibold transition-all duration-300 hover:shadow-md hover:transform hover:scale-105 w-full"
                        >
                            Solicitar beca
                        </a>
                    </div>
                </div>

                <!-- Card: Carnet Universitario -->
                <div
                    class="bg-white rounded-2xl p-8 shadow-lg border border-gray-100 hover:shadow-xl transition-all duration-300 group hover:border-purple-200 text-center flex flex-col min-h-[400px]"
                >
                    <div
                        class="w-16 h-16 bg-linear-to-br from-purple-500 to-pink-500 rounded-2xl flex items-center justify-center shadow-md mx-auto mb-6"
                    >
                        <svg
                            class="w-8 h-8 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5zm6-10.125a1.875 1.875 0 11-3.75 0 1.875 1.875 0 013.75 0zm1.294 6.336a6.721 6.721 0 01-3.17.789 6.721 6.721 0 01-3.168-.789 3.376 3.376 0 016.338 0z"
                            ></path>
                        </svg>
                    </div>
                    <h2 class="text-2xl font-bold text-gray-800 mb-4">
                        Carnet Universitario
                    </h2>
                    <p class="text-gray-600 mb-6 leading-relaxed grow">
                        Tu identificación oficial como estudiante UNET. Esencial
                        para acceso a instalaciones, biblioteca, eventos
                        universitarios y descuentos estudiantiles en diversos
                        establecimientos.
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div
                    class="bg-white rounded-2xl p-8 shadow-lg border border-gray-100 hover:shadow-xl transition-all duration-300 group hover:border-blue-200 text-center flex flex-col min-h-[400px]"
                >
                    <div
                        class="w-16 h-16 bg-linear-to-br from-green-500 to-emerald-500 rounded-2xl flex items-center justify-center shadow-md mx-auto mb-6"
                    >
                        <svg
                            class="w-8 h-8 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                            ></path>
                        </svg>
                    </div>
                    <h2 class="text-2xl font-bold text-gray-800 mb-4">
                        Pensum
                    </h2>
                    <p class="text-gray-600 mb-6 leading-relaxed grow">
                        Descubre el plan completo de materias y tu trayectoria
                        académica
                    </p>
                    <div class="mt-auto">
                        <a
                            href="/Pensum"
                            class="inline-block bg-linear-to-r from-green-500 to-emerald-500 text-white px-6 py-3 rounded-lg font-semibold transition-all duration-300 hover:shadow-md hover:transform hover:scale-105 w-full"
                        >
                            Conocer más sobre las materias
                        </a>
                    </div>
                </div>

                <div
                    class="bg-white rounded-2xl p-8 shadow-lg border border-gray-100 hover:shadow-xl transition-all duration-300 group hover:border-blue-200 text-center flex flex-col min-h-[400px]"
                >
                    <div
                        class="w-16 h-16 bg-linear-to-br from-blue-500 to-cyan-500 rounded-2xl flex items-center justify-center shadow-md mx-auto mb-6"
                    >
                        <svg
                            class="w-8 h-8 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                            ></path>
                        </svg>
                    </div>
                    <h2 class="text-2xl font-bold text-gray-800 mb-4">
                        Departamentos Académicos
                    </h2>
                    <p class="text-gray-600 mb-6 leading-relaxed grow">
                        Descubre los departamentos académicos de las Carreras
                    </p>
                    <div class="mt-auto">
                        <a
                            href="/Departamentos"
                            class="inline-block bg-linear-to-r from-blue-500 to-cyan-500 text-white px-6 py-3 rounded-lg font-semibold transition-all duration-300 hover:shadow-md hover:transform hover:scale-105 w-full"
                        >
                            Conocer más sobre los departamentos
                        </a>
                    </div>
                </div>

                <div
                    class="bg-white rounded-2xl p-8 shadow-lg border border-gray-100 hover:shadow-xl transition-all duration-300 group hover:border-blue-200 text-center flex flex-col min-h-[400px]"
                >
                    <div
                        class="w-16 h-16 bg-linear-to-br from-purple-500 to-pink-500 rounded-2xl flex items-center justify-center shadow-md mx-auto mb-6"
                    >
                        <svg
                            class="w-8 h-8 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                            ></path>
                        </svg>
                    </div>
                    <h2 class="text-2xl font-bold text-gray-800 mb-4">
                        Beca y Correo Estudiantil
                    </h2>
                    <p class="text-gray-600 mb-6 leading-relaxed grow">
                        Descubre sobre los beneficios de la beca y el correo
                        estudiantil
                    </p>
                    <div class="mt-auto">
                        <a
                            href="/BecaAndCorreo"
                            class="inline-block bg-linear-to-r from-purple-500 to-pink-500 text-white px-6 py-3 rounded-lg font-semibold transition-all duration-300 hover:shadow-md hover:transform hover:scale-105 w-full"
                        >
                            Conocer más sobre beneficios
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    @keyframes pulse-slow {
        0%,
        100% {
            opacity: 0.3;
        }
        50% {
            opacity: 0.5;
        }
    }
    .animate-pulse-slow {
        animation: pulse-slow 6s ease-in-out infinite;
    }
    .animation-delay-2000 {
        animation-delay: 2s;
    }
    .animation-delay-4000 {
        animation-delay: 4s;
    }
</style>
