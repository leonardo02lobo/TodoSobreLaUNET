---
import Layout from "../layout/Layout.astro";

---

<Layout title="Página No Encontrada - CEII UNET">
    <section class="min-h-screen bg-linear-to-br from-slate-50 to-gray-100 py-16 px-4 relative overflow-hidden">
        <div class="absolute inset-0 opacity-3">
            <div class="absolute top-0 left-0 w-72 h-72 bg-blue-100 rounded-full mix-blend-multiply filter blur-xl opacity-30 animate-pulse-slow"></div>
            <div class="absolute top-0 right-0 w-72 h-72 bg-green-100 rounded-full mix-blend-multiply filter blur-xl opacity-30 animate-pulse-slow animation-delay-2000"></div>
            <div class="absolute bottom-0 left-1/2 w-72 h-72 bg-cyan-100 rounded-full mix-blend-multiply filter blur-xl opacity-30 animate-pulse-slow animation-delay-4000"></div>
        </div>

        <div class="relative z-10 container mx-auto px-6 py-16 flex items-center justify-center min-h-screen">
            <div class="text-center max-w-2xl mx-auto">
                <div class="mb-8">
                    <div class="relative inline-block">
                        <div class="w-24 h-24 bg-linear-to-br from-red-500 to-pink-600 rounded-2xl flex items-center justify-center shadow-lg mx-auto mb-6">
                            <svg class="w-12 h-12 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.35 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                            </svg>
                        </div>
                        <div class="absolute -inset-3 bg-red-500 rounded-2xl blur opacity-30"></div>
                    </div>
                </div>

                <div class="bg-white/80 backdrop-blur-sm rounded-2xl p-8 shadow-lg border border-gray-200 mb-8">
                    <div class="flex items-center justify-center mb-6">
                        <div class="w-16 h-1.5 bg-linear-to-r from-red-500 to-pink-500 rounded-full"></div>
                    </div>

                    <h1 class="text-6xl lg:text-8xl font-bold text-gray-800 mb-4 bg-linear-to-r from-red-500 to-pink-600 bg-clip-text">
                        404
                    </h1>

                    <h2 class="text-2xl lg:text-3xl font-bold text-gray-800 mb-4">
                        Página No Encontrada
                    </h2>

                    <p class="text-gray-600 text-lg leading-relaxed mb-6 max-w-md mx-auto">
                        La página que estás buscando no existe o ha sido movida a otra ubicación.
                    </p>

                    <div class="flex items-center justify-center gap-3 text-gray-500 mb-6">
                        <div class="w-1.5 h-1.5 bg-gray-400 rounded-full"></div>
                        <span class="text-sm">Error 404 - Recurso no disponible</span>
                        <div class="w-1.5 h-1.5 bg-gray-400 rounded-full"></div>
                    </div>
                </div>

                <div class="bg-white/80 backdrop-blur-sm rounded-2xl p-6 shadow-lg border border-gray-200 mb-8">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center">
                            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <h3 class="text-lg font-bold text-gray-800">¿Qué puedes hacer?</h3>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-left">
                        <div class="flex items-start gap-3 p-3 rounded-xl hover:bg-gray-50 transition-colors">
                            <div class="w-6 h-6 bg-blue-500 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                                <span class="text-white text-xs font-bold">1</span>
                            </div>
                            <div>
                                <p class="text-sm text-gray-700 font-medium">Verificar la URL</p>
                                <p class="text-xs text-gray-500">Revisa que la dirección esté escrita correctamente</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-3 p-3 rounded-xl hover:bg-gray-50 transition-colors">
                            <div class="w-6 h-6 bg-green-500 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                                <span class="text-white text-xs font-bold">2</span>
                            </div>
                            <div>
                                <p class="text-sm text-gray-700 font-medium">Navegar desde el inicio</p>
                                <p class="text-xs text-gray-500">Usa el menú principal para encontrar lo que buscas</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-3 p-3 rounded-xl hover:bg-gray-50 transition-colors">
                            <div class="w-6 h-6 bg-purple-500 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                                <span class="text-white text-xs font-bold">3</span>
                            </div>
                            <div>
                                <p class="text-sm text-gray-700 font-medium">Reportar el problema</p>
                                <p class="text-xs text-gray-500">Contacta al CEII si crees que es un error</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                    <a 
                        href="/"
                        class="group bg-white/80 backdrop-blur-sm text-gray-800 px-8 py-4 rounded-xl font-semibold hover:bg-white hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-blue-300 hover:transform hover:scale-105 flex items-center gap-3 min-w-[200px] justify-center"
                    >
                        <svg class="w-5 h-5 text-blue-600 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                        </svg>
                        <span>Volver al Inicio</span>
                    </a>

                    <a 
                        href="/noticias"
                        class="group bg-blue-600 text-white px-8 py-4 rounded-xl font-semibold hover:bg-blue-700 transition-all duration-300 hover:shadow-lg hover:transform hover:scale-105 flex items-center gap-3 min-w-[200px] justify-center"
                    >
                        <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9m0 0v12m0-12a2 2 0 012-2h2a2 2 0 012 2m-6 9v2m0-2a2 2 0 002 2h2a2 2 0 002-2m0 0V9"></path>
                        </svg>
                        <span>Ir a Noticias</span>
                    </a>

                    <button 
                        onclick="history.back()"
                        class="group bg-transparent text-gray-600 px-8 py-4 rounded-xl font-semibold hover:bg-gray-100 transition-all duration-300 border border-gray-300 hover:border-gray-400 flex items-center gap-3 min-w-[200px] justify-center"
                    >
                        <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        <span>Volver Atrás</span>
                    </button>
                </div>

                <div class="mt-12 text-center">
                    <p class="text-gray-500 text-sm">
                        ¿Necesitas ayuda?{' '}
                        <a href="/contacto" class="text-blue-600 hover:text-blue-700 font-medium transition-colors">
                            Contacta al Centro de Estudiantes
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    @keyframes pulse-slow {
        0%, 100% { opacity: 0.3; }
        50% { opacity: 0.5; }
    }
    .animate-pulse-slow {
        animation: pulse-slow 6s ease-in-out infinite;
    }
    .animation-delay-2000 {
        animation-delay: 2s;
    }
    .animation-delay-4000 {
        animation-delay: 4s;
    }
</style>