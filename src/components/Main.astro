---
import CardInformation from "./CardInformation.astro";
---

<section class="bg-white py-20 px-4 relative overflow-hidden">
    <div
        class="flex flex-col lg:flex-row justify-center items-center relative max-w-full mx-auto gap-8"
    >
        <CardInformation
            title="Centro de Estudiantes CEII"
            subTitle="Representación estudiantil"
            description="El Centro de Estudiantes de Ingeniería en Informática (CEII) es la organización estudiantil que representa, defiende y promueve los intereses y el bienestar de todos los estudiantes de la carrera en la Universidad Nacional Experimental del Táchira (UNET)."
        >
            <svg
                slot="icon"
                class="w-6 h-6 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                ></path>
            </svg>
        </CardInformation>
        <CardInformation
            title="¿Qué es la Ingeniería Informática?"
            subTitle="Representación estudiantil"
            description="La Ingeniería Informática es la disciplina que aplica los fundamentos de la ciencia de la computación, el software y, a menudo, la electrónica, para diseñar, desarrollar, implementar y gestionar sistemas digitales integrales."
        >
            <svg
                slot="icon"
                class="w-6 h-6 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
                ></path>
            </svg>
        </CardInformation>
    </div>
</section>
