---
interface Props {
    title: string;
    content: string;
    variant?: 'simple' | 'featured';
}
const { title, content, variant = 'simple' } = Astro.props;
---

<article class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition-all duration-300 group hover:border-blue-300">
    <!-- Header con línea decorativa -->
    <div class="flex items-center justify-center mb-6">
        <div class="w-12 h-1 bg-linear-to-r from-blue-500 to-purple-500 rounded-full group-hover:w-16 transition-all duration-300"></div>
    </div>
    
    <!-- Título -->
    <h2 class="text-2xl font-bold text-gray-800 text-center mb-4 group-hover:text-blue-600 transition-colors duration-300">
        {title}
    </h2>
    
    <!-- Contenido -->
    <p class="text-gray-600 text-center leading-relaxed">
        {content}
    </p>
    
    <!-- Footer decorativo -->
    <div class="flex justify-center mt-6">
        <div class="w-8 h-0.5 bg-gray-300 group-hover:bg-blue-400 transition-colors duration-300"></div>
    </div>
</article>