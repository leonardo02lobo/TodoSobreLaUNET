---
interface Props {
    title: string;
    content: string;
    depa?: boolean;
    hora: string;
    dias?: string;
    correo?: string;
    jefe_departamento?: string;
}
const { title, content, depa, hora, dias, correo, jefe_departamento } =
    Astro.props;
---

<article
    class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition-all duration-300 group hover:border-blue-300"
>
    <div class="flex items-center justify-center mb-6">
        <div
            class="w-12 h-1 bg-linear-to-r from-blue-500 to-purple-500 rounded-full group-hover:w-16 transition-all duration-300"
        >
        </div>
    </div>

    <h2
        class="text-2xl font-bold text-gray-800 text-center mb-4 group-hover:text-blue-600 transition-colors duration-300"
    >
        {title}
    </h2>
    {
        depa ? (
            <p class="text-gray-600 text-center leading-relaxed">
                <strong>Jefe de Departamento:</strong> {jefe_departamento} <br />
                <strong>Correo:</strong> {correo} <br />
                <strong>Días de Atención:</strong> {dias} <br />
                <strong>Horario:</strong> {hora}
            </p>
        ) : (
            <p class="text-gray-600 text-center leading-relaxed">{content}</p>
        )
    }

    <div class="flex justify-center mt-6">
        <div
            class="w-8 h-0.5 bg-gray-300 group-hover:bg-blue-400 transition-colors duration-300"
        >
        </div>
    </div>
</article>
